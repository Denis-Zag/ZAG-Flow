# Публичный порт сайта на локальной машине или сервере.
HTTP_PORT=8080

# Ключ создания услуг. Пустое значение отключает запись каталога.
# В Swagger используйте Authorize через localhost или SSH-туннель.
SERVICE_ADMIN_TOKEN=

# PostgreSQL. Для реального запуска замените все значения.
POSTGRES_DB=zag_flow
POSTGRES_USER=zag_flow_app
POSTGRES_PASSWORD=change_me_to_a_long_unique_password

# pgAdmin доступен только через localhost сервера или SSH-туннель.
PGADMIN_HOST_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change_me_to_another_long_unique_password

# Используется скриптом registry/create-user.sh, но не Docker Compose.
REGISTRY_USER=zagflow

# Отдельная длинная случайная строка для подписи внутренних запросов Registry.
REGISTRY_HTTP_SECRET=change_me_to_a_long_random_registry_secret
